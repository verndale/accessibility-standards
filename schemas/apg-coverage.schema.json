{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apg-coverage.schema.json",
  "$defs": {
    "recordIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:pattern|semantics)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
    },
    "patternEntry": {
      "type": "object",
      "required": ["id", "coverage", "record_ids"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "coverage": { "enum": ["baseline-semantics", "composed", "dedicated-pattern"] },
        "record_ids": { "$ref": "#/$defs/recordIds" }
      }
    },
    "practiceEntry": {
      "type": "object",
      "required": ["id", "record_ids"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "record_ids": { "$ref": "#/$defs/recordIds" }
      }
    }
  },
  "type": "object",
  "required": ["version", "authority", "patterns_url", "practices_url", "patterns", "practices"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "authority": { "const": "aria-apg" },
    "patterns_url": { "const": "https://www.w3.org/WAI/ARIA/apg/patterns/" },
    "practices_url": { "const": "https://www.w3.org/WAI/ARIA/apg/practices/" },
    "patterns": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "uniqueItems": true,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "accordion" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "alert" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "alertdialog" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "breadcrumb" }, "coverage": { "const": "baseline-semantics" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "button" }, "coverage": { "const": "composed" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "carousel" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "checkbox" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "combobox" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "dialog-modal" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "disclosure" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "feed" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "grid" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "landmarks" }, "coverage": { "const": "baseline-semantics" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "link" }, "coverage": { "const": "baseline-semantics" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "listbox" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "menubar" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "menu-button" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "meter" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "radio" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "slider" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "slider-multithumb" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "spinbutton" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "switch" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "table" }, "coverage": { "const": "baseline-semantics" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "tabs" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "toolbar" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "tooltip" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "treeview" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "treegrid" }, "coverage": { "const": "dedicated-pattern" } } }] },
        { "allOf": [{ "$ref": "#/$defs/patternEntry" }, { "properties": { "id": { "const": "windowsplitter" }, "coverage": { "const": "dedicated-pattern" } } }] }
      ],
      "items": false
    },
    "practices": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/practiceEntry" }, { "properties": { "id": { "const": "landmark-regions" } } }] },
        { "allOf": [{ "$ref": "#/$defs/practiceEntry" }, { "properties": { "id": { "const": "names-and-descriptions" } } }] },
        { "allOf": [{ "$ref": "#/$defs/practiceEntry" }, { "properties": { "id": { "const": "keyboard-interface" } } }] },
        { "allOf": [{ "$ref": "#/$defs/practiceEntry" }, { "properties": { "id": { "const": "grid-and-table-properties" } } }] },
        { "allOf": [{ "$ref": "#/$defs/practiceEntry" }, { "properties": { "id": { "const": "range-related-properties" } } }] },
        { "allOf": [{ "$ref": "#/$defs/practiceEntry" }, { "properties": { "id": { "const": "structural-roles" } } }] },
        { "allOf": [{ "$ref": "#/$defs/practiceEntry" }, { "properties": { "id": { "const": "hiding-semantics" } } }] }
      ],
      "items": false
    }
  }
}
